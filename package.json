{
  "name": "monk-health-charter-dashboard",
  "version": "1.0.0",
  "description": "ธรรมนูญสุขภาพพระสงฆ์แห่งชาติ — Dashboard (Vanilla JS SPA)",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "vite build && wrangler deploy",
    "cf-dev": "vite build && wrangler dev",
    "db:migrate": "wrangler d1 migrations apply monk-health --remote",
    "db:seed": "wrangler d1 execute monk-health --remote --file etl/output/seed.sql"
  },
  "devDependencies": {
    "jsdom": "^30.0.1",
    "vite": "^5.4.10",
    "wrangler": "^4.130.0"
  }
}
