{
  // ── production (Worker + D1, สาธารณะ ไม่มี auth) ─────────────
  //   deploy:  npm run deploy
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "monk-health-charter",
  "compatibility_date": "2024-11-01",
  "main": "worker/index.js",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "monk-health",
      "database_id": "3ee0448b-b10a-458c-9020-fdf94493e56c"
    }
  ]
}
